# PostgreSQL Database Connection (e.g. Neon Serverless Postgres)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key & Model (optional model override)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# CEDA Agmarknet API Key
CEDA_API_KEY=your_ceda_api_key_here

# JWT Authentication
JWT_SECRET=your_super_secret_production_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Production CORS (Comma-separated allowed frontend URLs)
CORS_ORIGINS=https://pantriva.vercel.app,http://localhost:5173,http://localhost:3000

# CEDA Mandi Market Resolution Defaults (Optional)
CEDA_STATE_ID=8
CEDA_DISTRICT_ID=104
CEDA_MARKET_ID=255
